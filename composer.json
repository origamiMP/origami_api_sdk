{
    "name": "origami-mp/origami-api-sdk",
    "version": "v6.5.0",
    "description": "A lightweight package to interact easily with Origami API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Origami Marketplace",
            "email": "developers@origami-marketplace.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/support": "^13.0",
        "nesbot/carbon": "^3.9"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "phpstan/phpstan": "^2.1",
        "psy/psysh": "^0.12.8",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "OrigamiMp\\OrigamiApiSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
